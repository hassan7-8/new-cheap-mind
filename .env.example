# Copy to .env (local) or add as Environment Variables on Vercel. Never commit real secrets.

# Supabase (public values - also exposed to the browser as VITE_*)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# REQUIRED for guest access codes and the /admin page (server only, keep secret)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: override the values hardcoded in src/lib/ai-config.server.ts
GEMINI_API_KEY=
GROQ_API_KEY=
GUEST_ACCESS_CODE=
ADMIN_CODE=
